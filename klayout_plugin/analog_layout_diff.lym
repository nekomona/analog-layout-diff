<?xml version="1.0" encoding="utf-8"?>
<klayout-macro>
 <description>Analog layout diff: capture, commit, history and colored review</description>
 <version>0.1</version>
 <category>layout</category>
 <prolog/>
 <epilog/>
 <doc/>
 <autorun>true</autorun>
 <autorun-early>false</autorun-early>
 <shortcut/>
 <show-in-menu>false</show-in-menu>
 <group-name/>
 <menu-path/>
 <interpreter>python</interpreter>
 <dsl-interpreter-name/>
 <text><![CDATA[
# Import this macro IN PLACE from klayout_plugin/ in KLayout's Macro Development
# window. If copied elsewhere, set ANALOG_LAYOUT_DIFF_ROOT to the repo directory
# containing layoutdiff/ and klayout_plugin/ before launching KLayout.
import os
import sys
from pathlib import Path

root = Path(os.environ.get("ANALOG_LAYOUT_DIFF_ROOT", str(Path(__file__).resolve().parent.parent)))
if not (root / "layoutdiff" / "core.py").is_file():
    raise RuntimeError("Set ANALOG_LAYOUT_DIFF_ROOT to the analog-layout-diff directory")
sys.path.insert(0, str(root))
from klayout_plugin.gui import install
install()
]]></text>
</klayout-macro>
